@prefix aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#> .
@prefix surf: <https://github.com/seanchatmangpt/ash_surface#> .

surf:AshSurfaceSpec a aex:AshExtensionSpec ;
    aex:packageName "ash_surface" ;
    aex:moduleName "AshSurface.Resource" ;
    aex:extensionTarget "resource" ;
    aex:singleExtensionKind "ash_surface" ;
    aex:taskModuleName "AshSurface" ;
    aex:formatterModule "AshSurface.Formatter" ;
    aex:workflowReactor false ;
    aex:workflowReversible false ;
    aex:provenanceSource "ash_manifest" ;
    aex:validateDelegateModule "AshSurface.Resource.Validator" ;
    aex:validateDelegateFunction "validate" .

surf:SurfaceSection a aex:DslSection ;
    aex:sectionOf surf:AshSurfaceSpec ;
    aex:sectionName "surface" ;
    aex:sectionOrder 1 ;
    aex:sectionDescribe "Declares consumer projection intent for public Ash actions without duplicating Ash semantics." .

surf:ProjectionEntity a aex:DslEntity ;
    aex:entityOf surf:SurfaceSection ;
    aex:entityOrder 1 ;
    aex:entityName "projection" ;
    aex:entityStruct "AshSurface.Dsl.Projection" ;
    aex:entityIdentifier "action" .

surf:ProjectionActionArg a aex:EntityArg ;
    aex:argOf surf:ProjectionEntity ;
    aex:argOrder 1 ;
    aex:argName "action" .

surf:ProjectionActionField a aex:EntitySchemaField ;
    aex:fieldOf surf:ProjectionEntity ;
    aex:fieldOrder 1 ;
    aex:fieldName "action" ;
    aex:fieldType "atom" ;
    aex:fieldRequired true ;
    aex:fieldDoc "Public Ash action name this projection describes." .

surf:ProjectionConsumerField a aex:EntitySchemaField ;
    aex:fieldOf surf:ProjectionEntity ;
    aex:fieldOrder 2 ;
    aex:fieldName "consumer" ;
    aex:fieldType "atom" ;
    aex:fieldRequired false ;
    aex:fieldDoc "Optional consumer class such as web, mobile, or internal." .

surf:ProjectionTransportField a aex:EntitySchemaField ;
    aex:fieldOf surf:ProjectionEntity ;
    aex:fieldOrder 3 ;
    aex:fieldName "transport" ;
    aex:fieldType "one_of" ;
    aex:fieldRequired false ;
    aex:fieldDefault ":auto" ;
    aex:fieldDoc "Pre-dispatch transport preference; auto preserves all admitted alternatives." .

surf:TransportAuto a aex:FieldOneOfValue ;
    aex:oneOfValueOf surf:ProjectionTransportField ;
    aex:oneOfValueOrder 1 ;
    aex:oneOfValueName "auto" .

surf:TransportHttp a aex:FieldOneOfValue ;
    aex:oneOfValueOf surf:ProjectionTransportField ;
    aex:oneOfValueOrder 2 ;
    aex:oneOfValueName "http" .

surf:TransportChannel a aex:FieldOneOfValue ;
    aex:oneOfValueOf surf:ProjectionTransportField ;
    aex:oneOfValueOrder 3 ;
    aex:oneOfValueName "phoenix_channel" .

## v26.9.16 law rows (ontology-law-rows-007).
## Admitted, not proposed: ggen.toml [ontology] source names this file as the
## authorship origin; no generated header is present. Canonical enforcing-test
## paths are the integrated-wave paths (exp/v50); planning_episode_test.exs is
## live at this base, the IR/delegation paths resolve at wave integration.

surf:SurfaceIR a surf:LawRow ;
    surf:lawOrder 1 ;
    surf:lawName "SurfaceIR" ;
    surf:lawDoc "The canonical normalized intermediate representation: a dumb carrier that re-states admitted facts, never re-decides them." ;
    surf:sectionProperty surf:IRAshSection,
        surf:IRSemanticSection,
        surf:IRCapabilitySection,
        surf:IRPresentationSection,
        surf:IRSchemaSection ;
    surf:enforcedBy "test/ash_surface/ir_test.exs" .

surf:IRAshSection a surf:IRSectionProperty ;
    surf:sectionOrder 1 ;
    surf:sectionName "ash" ;
    surf:sectionDoc "Normalized Ash manifest facts (resource/action identity, inputs, outputs, policies). Ash remains authoritative; the IR re-states, never re-decides." .

surf:IRSemanticSection a surf:IRSectionProperty ;
    surf:sectionOrder 2 ;
    surf:sectionName "semantic" ;
    surf:sectionDoc "Semantic layer facts (subject/capability IRIs, predicates, shape, ontology)." .

surf:IRCapabilitySection a surf:IRSectionProperty ;
    surf:sectionOrder 3 ;
    surf:sectionName "capability" ;
    surf:sectionDoc "Capability law facts (consequence class, authority and receipt requirements) as admitted facts, never as grants." .

surf:IRPresentationSection a surf:IRSectionProperty ;
    surf:sectionOrder 4 ;
    surf:sectionName "presentation" ;
    surf:sectionDoc "Presentation descriptors (label, group, order, widget, format)." .

surf:IRSchemaSection a surf:IRSectionProperty ;
    surf:sectionOrder 5 ;
    surf:sectionName "schema" ;
    surf:sectionDoc "Boundary schemas (input, output, the Zod projection, aria)." .

surf:ProjectionBoundary a surf:LawInvariant ;
    surf:lawOrder 2 ;
    surf:invariantDoc "A projection boundary (SurfaceIR and every projector consuming it) determines nothing about existence, meaning, or DO-authority; it carries admitted facts from its sources, and consumers re-derive standing from the sources." ;
    surf:enforcedBy "test/ash_surface/ir_test.exs" .

surf:DelegationEdge a surf:LawEdge ;
    surf:lawOrder 3 ;
    surf:edgeKind "delegation" ;
    surf:edgeDoc "Delegated facts, never local derivations: each is read from the manifest's custom.ash_surface profile when a delegating authority stored it there, and is nil otherwise. No fabricated capability truth." ;
    surf:delegatedFact "semanticId" ,
        "authorityBoundary" ,
        "doAuthority" ,
        "receiptRequired" ;
    surf:enforcedBy "test/ash_surface_test.exs" ,
        "test/ash_surface/compiler/capability_section_test.exs" .

surf:IntentEdge a surf:LawEdge ;
    surf:lawOrder 4 ;
    surf:edgeKind "intent" ;
    surf:edgeFrom "human" ;
    surf:edgeTo "candidate" ;
    surf:edgeDoc "Human intent terminates at candidate actions whose authority ceiling is strictly SELECT or CONSTRUCT; there is no direct human-to-DO edge. PlanningEpisode authority_ceiling can never be :DO." ;
    surf:enforcedBy "test/ash_surface/planning_episode_test.exs" .

## v26.9.17 law rows (gapfix-ontology-promo-017): the 並 capacity family.
## Promoted from operating prose (延: every concept keeps a repo-side
## enforcement anchor). Mirror-reference: the canonical 並 fact belongs to
## dfcm-agent-pack; admitting it there is an operator cut. Capacity is a
## per-(model_tier, agent_weight) measurement — other tiers carry their own
## measured ceilings and are NOT expressed by these rows.

surf:CapacityTierLaw a surf:LawRow ;
    surf:lawOrder 5 ;
    surf:lawName "CapacityTierLaw" ;
    surf:lawDoc "並 capacity = f(model_tier, agent_weight), measured never assumed; re-measured on every tier change. Dispatch telemetry lands in capacity-ride/log.ndjson as one JSON object per observation (ts, tier, weight, target_n, rider)." ;
    surf:capacityTelemetry "capacity-ride/log.ndjson" ;
    surf:enforcedBy "scripts/capacity_gate.sh" ,
        "test/ash_surface/capacity_gate_test.exs" ,
        "test/ash_surface/ontology_enforced_by_test.exs" .

surf:FlashHeavyweightCeiling a surf:LawRow ;
    surf:lawOrder 6 ;
    surf:lawName "FlashHeavyweightCeiling" ;
    surf:lawDoc "Flash-tier heavyweight agents run at most 16 in flight (measured 2026-09-17). A non-rider dispatch observation with target_n above 16 is a capacity violation." ;
    surf:capacityTier "flash" ;
    surf:capacityWeight "heavyweight" ;
    surf:capacityCeiling 16 ;
    surf:enforcedBy "scripts/capacity_gate.sh" ,
        "test/ash_surface/capacity_gate_test.exs" ,
        "test/ash_surface/ontology_enforced_by_test.exs" .

surf:RiderSetpointLaw a surf:LawRow ;
    surf:lawOrder 7 ;
    surf:lawName "RiderSetpointLaw" ;
    surf:lawDoc "A rider-supplied target_n is the operator setpoint: it overrides tier ceilings, and the capacity gate skips rider rows (rider true) instead of judging them." ;
    surf:enforcedBy "scripts/capacity_gate.sh" ,
        "test/ash_surface/capacity_gate_test.exs" ,
        "test/ash_surface/ontology_enforced_by_test.exs" .

surf:StormProtocol a surf:LawRow ;
    surf:lawOrder 8 ;
    surf:lawName "StormProtocol" ;
    surf:lawDoc "Above 30 concurrent dispatches the rate refuser answers [1302]. On [1302]: stop, drain the window (minutes), resume at half pace; a repeat refusal halves the pace again. Saturation is reached by top-up (replacement launches on completion), never by bulk burst. Row-preservation anchor: ontology_enforced_by_test." ;
    surf:enforcedBy "test/ash_surface/ontology_enforced_by_test.exs" .
