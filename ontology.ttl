# Accessibility surface semantics intentionally align to public W3C vocabularies
# instead of cloning the WAI-ARIA role taxonomy into AshSurface.
surf:AccessibilityVocabulary a rdfs:Class .
surf:SurfaceObserver a rdfs:Class .
surf:SurfaceObservation a rdfs:Class .
surf:AccessibilityProbe a rdfs:Class .
surf:ProbeResult a rdfs:Class ;
    rdfs:subClassOf earl:TestResult .

surf:WaiAriaVocabulary a surf:AccessibilityVocabulary ;
    surf:specification <https://www.w3.org/TR/wai-aria/> .

surf:ActRulesFormat a rdfs:Resource ;
    surf:specification <https://www.w3.org/TR/act-rules-format/> .

surf:EarlVocabulary a rdfs:Resource ;
    surf:specification <https://www.w3.org/TR/EARL10-Schema/> .

surf:PlaywrightAccessibilityObserver a surf:SurfaceObserver ;
    surf:usesVocabulary surf:WaiAriaVocabulary ;
    surf:runtime "playwright" ;
    surf:authorityBoundary "OBSERVE" ;
    surf:emits surf:AccessibilityObservationProjection .

surf:AccessibilityObservationProjection a surf:SurfaceObservation ;
    surf:authorityBoundary "OBSERVE" ;
    surf:conformanceRuleFormat surf:ActRulesFormat ;
    surf:resultVocabulary surf:EarlVocabulary .

surf:specification a rdf:Property ;
    rdfs:range rdfs:Resource .

surf:usesVocabulary a rdf:Property ;
    rdfs:domain surf:SurfaceObserver ;
    rdfs:range surf:AccessibilityVocabulary .

surf:runtime a rdf:Property ;
    rdfs:range xsd:string .

surf:authorityBoundary a rdf:Property ;
    rdfs:range xsd:string .

surf:emits a rdf:Property ;
    rdfs:domain surf:SurfaceObserver ;
    rdfs:range surf:SurfaceObservation .

surf:expectedRoleName a rdf:Property ;
    rdfs:domain surf:AccessibilityProbe ;
    rdfs:range xsd:string ;
    rdfs:comment "Concrete WAI-ARIA role name consumed by Playwright getByRole; the WAI-ARIA specification remains authoritative." .

surf:expectedRoleSpec a rdf:Property ;
    rdfs:domain surf:AccessibilityProbe ;
    rdfs:range rdfs:Resource .

surf:expectedAccessibleName a rdf:Property ;
    rdfs:domain surf:AccessibilityProbe ;
    rdfs:range xsd:string .

surf:denotes a rdf:Property ;
    rdfs:domain surf:AccessibilityProbe ;
    rdfs:comment "Links an accessible surface target to the domain object it denotes." .

surf:affordsCapability a rdf:Property ;
    rdfs:domain surf:AccessibilityProbe ;
    rdfs:comment "Links an accessible surface target to a canonical capability identity; it does not grant execution authority." .

surf:conformanceRuleFormat a rdf:Property .
surf:resultVocabulary a rdf:Property .


# DfCM live-operations consumer projections. These terms describe read models
# only; they do not grant SELECT, CONSTRUCT, or DO authority.
surf:OperationalObligation a rdfs:Class ;
    rdfs:comment "OBSERVE-only projection of an upstream-manufactured capability obligation." .

surf:CommandCenterProjection a rdfs:Class ;
    rdfs:comment "Deterministic consumer composition of observations, obligations, planning episodes, capabilities, and receipt identities." .

surf:capabilityId a rdf:Property ;
    rdfs:domain surf:OperationalObligation ;
    rdfs:range xsd:string .

surf:causeRef a rdf:Property ;
    rdfs:domain surf:OperationalObligation ;
    rdfs:range xsd:string .

surf:receiptRef a rdf:Property ;
    rdfs:range xsd:string .

surf:postconditionRef a rdf:Property ;
    rdfs:range xsd:string .

surf:operationalAuthorityBoundary a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "AshSurface operational projections use the literal OBSERVE." .


# Human-facing DfCM projection vocabulary.
# These terms project already-admitted semantics into understandable choices,
# explanations, practices, commitments, and replay. They never grant DO authority.
surf:HumanSurfaceProjection a rdfs:Class ;
    rdfs:comment "OBSERVE-only projection with TODAY/BIBLE/LIFE/ZOE/YOU human areas." .

surf:PossibilitySet a rdfs:Class ;
    rdfs:comment "A DfCM frontier preserving plural lawful alternatives until explicit selection or closure." .

surf:Possibility a rdfs:Class ;
    rdfs:comment "One human-facing candidate option; never an execution authority." .

surf:WhyThisExplanation a rdfs:Class ;
    rdfs:comment "Evidence-bounded explanation of why a candidate may be relevant to the subject." .

surf:OutcomeHypothesis a rdfs:Class ;
    rdfs:comment "Falsifiable non-causal candidate relationship between a practice and a selected outcome." .

surf:DevotionalEpisode a rdfs:Class ;
    rdfs:comment "Ordered devotional program intended for straight-through listening or reading." .

surf:DevotionalSegment a rdfs:Class ;
    rdfs:comment "Ordered scripture, commentary, prayer, reflection, music, or transition segment." .

surf:CommitmentBoundary a rdfs:Class ;
    rdfs:comment "Human confirmation projection that stops at CONSTRUCT and hands consequence-bearing intent to BRCE." .

surf:JourneyProjection a rdfs:Class ;
    rdfs:comment "Subject-private human replay over observed events, evidence, and receipts." .

surf:HumanArea a rdfs:Class .
surf:HumanGrammarStep a rdfs:Class .

surf:TodayArea a surf:HumanArea .
surf:BibleArea a surf:HumanArea .
surf:LifeArea a surf:HumanArea .
surf:ZoeArea a surf:HumanArea .
surf:YouArea a surf:HumanArea .

surf:SeeStep a surf:HumanGrammarStep .
surf:UnderstandStep a surf:HumanGrammarStep .
surf:ExploreStep a surf:HumanGrammarStep .
surf:ChooseStep a surf:HumanGrammarStep .
surf:ActStep a surf:HumanGrammarStep ;
    rdfs:comment "Presents a commitment boundary; does not denote DO authority." .
surf:LearnStep a surf:HumanGrammarStep .

surf:hasHumanArea a rdf:Property ;
    rdfs:domain surf:HumanSurfaceProjection ;
    rdfs:range surf:HumanArea .

surf:hasGrammarStep a rdf:Property ;
    rdfs:domain surf:HumanSurfaceProjection ;
    rdfs:range surf:HumanGrammarStep .

surf:hasPossibilitySet a rdf:Property ;
    rdfs:domain surf:HumanSurfaceProjection ;
    rdfs:range surf:PossibilitySet .

surf:hasPossibility a rdf:Property ;
    rdfs:domain surf:PossibilitySet ;
    rdfs:range surf:Possibility .

surf:objective a rdf:Property ;
    rdfs:domain surf:PossibilitySet ;
    rdfs:range xsd:string .

surf:reversibility a rdf:Property ;
    rdfs:domain surf:Possibility ;
    rdfs:range xsd:string .

surf:whyThis a rdf:Property ;
    rdfs:range surf:WhyThisExplanation .

surf:claimKind a rdf:Property ;
    rdfs:domain surf:WhyThisExplanation ;
    rdfs:range xsd:string .

surf:falsifier a rdf:Property ;
    rdfs:range xsd:string .

surf:evidenceState a rdf:Property ;
    rdfs:range xsd:string .

surf:practiceRef a rdf:Property ;
    rdfs:domain surf:OutcomeHypothesis ;
    rdfs:range xsd:string .

surf:outcomeRef a rdf:Property ;
    rdfs:domain surf:OutcomeHypothesis ;
    rdfs:range xsd:string .

surf:causalClaim a rdf:Property ;
    rdfs:domain surf:OutcomeHypothesis ;
    rdfs:range xsd:boolean .

surf:hasDevotionalEpisode a rdf:Property ;
    rdfs:domain surf:HumanSurfaceProjection ;
    rdfs:range surf:DevotionalEpisode .

surf:hasSegment a rdf:Property ;
    rdfs:domain surf:DevotionalEpisode ;
    rdfs:range surf:DevotionalSegment .

surf:segmentPosition a rdf:Property ;
    rdfs:domain surf:DevotionalSegment ;
    rdfs:range xsd:integer .

surf:continuousPlay a rdf:Property ;
    rdfs:domain surf:DevotionalEpisode ;
    rdfs:range xsd:boolean .

surf:playbackPolicy a rdf:Property ;
    rdfs:domain surf:DevotionalEpisode ;
    rdfs:range xsd:string .

surf:hasCommitmentBoundary a rdf:Property ;
    rdfs:domain surf:HumanSurfaceProjection ;
    rdfs:range surf:CommitmentBoundary .

surf:confirmationState a rdf:Property ;
    rdfs:domain surf:CommitmentBoundary ;
    rdfs:range xsd:string .

surf:nextHandoff a rdf:Property ;
    rdfs:domain surf:CommitmentBoundary ;
    rdfs:range xsd:string .

surf:doAuthority a rdf:Property ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Human AshSurface projections require false; consequence authority lives outside the projection." .

surf:hasJourney a rdf:Property ;
    rdfs:domain surf:HumanSurfaceProjection ;
    rdfs:range surf:JourneyProjection .

surf:privacyScope a rdf:Property ;
    rdfs:domain surf:JourneyProjection ;
    rdfs:range xsd:string .

surf:ZoeHumanSurfaceContract a surf:HumanSurfaceProjection ;
    surf:authorityBoundary "OBSERVE" ;
    surf:doAuthority false ;
    surf:hasHumanArea surf:TodayArea, surf:BibleArea, surf:LifeArea, surf:ZoeArea, surf:YouArea ;
    surf:hasGrammarStep surf:SeeStep, surf:UnderstandStep, surf:ExploreStep, surf:ChooseStep, surf:ActStep, surf:LearnStep .


# Subject-private personalization and Chatman equation projection.
surf:PersonalizationContext a rdfs:Class ;
    rdfs:comment "Subject-private projection of USER_STATED, OBSERVED, and INFERRED personalization facets." .

surf:PersonalizationFacet a rdfs:Class ;
    rdfs:comment "One provenance-typed profile facet used only as bounded personalization evidence." .

surf:ManufactureTrace a rdfs:Class ;
    rdfs:comment "OBSERVE-only provenance projection of A = mu(O*), including exact admitted O* evidence and receipts." .

surf:hasPersonalizationContext a rdf:Property ;
    rdfs:domain surf:HumanSurfaceProjection ;
    rdfs:range surf:PersonalizationContext .

surf:hasPersonalizationFacet a rdf:Property ;
    rdfs:domain surf:PersonalizationContext ;
    rdfs:range surf:PersonalizationFacet .

surf:facetDimension a rdf:Property ;
    rdfs:domain surf:PersonalizationFacet ;
    rdfs:range xsd:string .

surf:facetValueRef a rdf:Property ;
    rdfs:domain surf:PersonalizationFacet ;
    rdfs:range xsd:string .

surf:facetSource a rdf:Property ;
    rdfs:domain surf:PersonalizationFacet ;
    rdfs:range xsd:string ;
    rdfs:comment "Literal source class USER_STATED, OBSERVED, or INFERRED; inference never becomes testimony." .

surf:shareScope a rdf:Property ;
    rdfs:domain surf:PersonalizationContext ;
    rdfs:range xsd:string .

surf:consentRef a rdf:Property ;
    rdfs:domain surf:PersonalizationContext ;
    rdfs:range xsd:string .

surf:hasManufactureTrace a rdf:Property ;
    rdfs:domain surf:HumanSurfaceProjection ;
    rdfs:range surf:ManufactureTrace .

surf:artifactRef a rdf:Property ;
    rdfs:domain surf:ManufactureTrace ;
    rdfs:range xsd:string .

surf:manufacturerIdentity a rdf:Property ;
    rdfs:domain surf:ManufactureTrace ;
    rdfs:range xsd:string .

surf:observedRef a rdf:Property ;
    rdfs:domain surf:ManufactureTrace ;
    rdfs:range xsd:string .

surf:admittedRef a rdf:Property ;
    rdfs:domain surf:ManufactureTrace ;
    rdfs:range xsd:string .

surf:groundedRef a rdf:Property ;
    rdfs:domain surf:ManufactureTrace ;
    rdfs:range xsd:string .

surf:boundedRef a rdf:Property ;
    rdfs:domain surf:ManufactureTrace ;
    rdfs:range xsd:string .

surf:alignedRef a rdf:Property ;
    rdfs:domain surf:ManufactureTrace ;
    rdfs:range xsd:string .

surf:oStarRef a rdf:Property ;
    rdfs:domain surf:ManufactureTrace ;
    rdfs:range xsd:string ;
    rdfs:comment "Reference admitted only when present in observed, admitted, grounded, bounded, and aligned sets." .

surf:equation a rdf:Property ;
    rdfs:domain surf:ManufactureTrace ;
    rdfs:range xsd:string .

surf:ZoePersonalizationContract a surf:PersonalizationContext ;
    surf:privacyScope "SUBJECT_PRIVATE" ;
    surf:shareScope "SUBJECT_ONLY" ;
    surf:authorityBoundary "OBSERVE" ;
    surf:doAuthority false .

surf:ZoeManufactureTraceContract a surf:ManufactureTrace ;
    surf:equation "A=mu(O*)" ;
    surf:authorityBoundary "OBSERVE" ;
    surf:doAuthority false .
surf:UnsupportedLedgerRow48 a surf:UnsupportedRow ;
    surf:ledgerPath "lib/ash_surface/{human_surface,devotional_episode,commitment_boundary,journey,manufacture_trace,outcome_hypothesis,personalization_context,possibility,possibility_set,why_this}.ex + lib/ash_surface/zoe_demo.ex + test/ash_surface/{human_surface,zoe_demo}_test.exs" ;
    surf:unsupportedGenerator "ash-extension-pack (ggen-marketplace)" ;
    surf:unsupportedElement "human-surface resource family template emission (ontology facts -> Ash surface resources + projections + demo)" ;
    surf:ledgerDate "2026-09-21" ;
    surf:enforcedBy "test/ash_surface/handwritten_ledger_test.exs" .
