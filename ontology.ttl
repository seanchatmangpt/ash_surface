@prefix aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#> .
@prefix surf: <https://github.com/seanchatmangpt/ash_surface#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix earl: <http://www.w3.org/ns/earl#> .

surf:AshSurfaceSpec a aex:AshExtensionSpec ;
    aex:packageName "ash_surface" ;
    aex:moduleName "AshSurface.Resource" ;
    aex:extensionTarget "resource" ;
    aex:singleExtensionKind "ash_surface" ;
    aex:taskModuleName "AshSurface" ;
    aex:formatterModule "AshSurface.Formatter" ;
    aex:workflowReactor false ;
    aex:workflowReversible false ;
    aex:provenanceSource "ash_manifest" ;
    aex:validateDelegateModule "AshSurface.Resource.Validator" ;
    aex:validateDelegateFunction "validate" .

surf:SurfaceSection a aex:DslSection ;
    aex:sectionOf surf:AshSurfaceSpec ;
    aex:sectionName "surface" ;
    aex:sectionOrder 1 ;
    aex:sectionDescribe "Declares consumer projection intent for public Ash actions without duplicating Ash semantics." .

surf:ProjectionEntity a aex:DslEntity ;
    aex:entityOf surf:SurfaceSection ;
    aex:entityOrder 1 ;
    aex:entityName "projection" ;
    aex:entityStruct "AshSurface.Dsl.Projection" ;
    aex:entityIdentifier "action" .

surf:ProjectionActionArg a aex:EntityArg ;
    aex:argOf surf:ProjectionEntity ;
    aex:argOrder 1 ;
    aex:argName "action" .

surf:ProjectionActionField a aex:EntitySchemaField ;
    aex:fieldOf surf:ProjectionEntity ;
    aex:fieldOrder 1 ;
    aex:fieldName "action" ;
    aex:fieldType "atom" ;
    aex:fieldRequired true ;
    aex:fieldDoc "Public Ash action name this projection describes." .

surf:ProjectionConsumerField a aex:EntitySchemaField ;
    aex:fieldOf surf:ProjectionEntity ;
    aex:fieldOrder 2 ;
    aex:fieldName "consumer" ;
    aex:fieldType "atom" ;
    aex:fieldRequired false ;
    aex:fieldDoc "Optional consumer class such as web, mobile, or internal." .

surf:ProjectionTransportField a aex:EntitySchemaField ;
    aex:fieldOf surf:ProjectionEntity ;
    aex:fieldOrder 3 ;
    aex:fieldName "transport" ;
    aex:fieldType "one_of" ;
    aex:fieldRequired false ;
    aex:fieldDefault ":auto" ;
    aex:fieldDoc "Pre-dispatch transport preference; auto preserves all admitted alternatives." .

surf:TransportAuto a aex:FieldOneOfValue ;
    aex:oneOfValueOf surf:ProjectionTransportField ;
    aex:oneOfValueOrder 1 ;
    aex:oneOfValueName "auto" .

surf:TransportHttp a aex:FieldOneOfValue ;
    aex:oneOfValueOf surf:ProjectionTransportField ;
    aex:oneOfValueOrder 2 ;
    aex:oneOfValueName "http" .

surf:TransportChannel a aex:FieldOneOfValue ;
    aex:oneOfValueOf surf:ProjectionTransportField ;
    aex:oneOfValueOrder 3 ;
    aex:oneOfValueName "phoenix_channel" .

# Accessibility surface semantics intentionally align to public W3C vocabularies
# instead of cloning the WAI-ARIA role taxonomy into AshSurface.
surf:AccessibilityVocabulary a rdfs:Class .
surf:SurfaceObserver a rdfs:Class .
surf:SurfaceObservation a rdfs:Class .
surf:AccessibilityProbe a rdfs:Class .
surf:ProbeResult a rdfs:Class ;
    rdfs:subClassOf earl:TestResult .

surf:WaiAriaVocabulary a surf:AccessibilityVocabulary ;
    surf:specification <https://www.w3.org/TR/wai-aria/> .

surf:ActRulesFormat a rdfs:Resource ;
    surf:specification <https://www.w3.org/TR/act-rules-format/> .

surf:EarlVocabulary a rdfs:Resource ;
    surf:specification <https://www.w3.org/TR/EARL10-Schema/> .

surf:PlaywrightAccessibilityObserver a surf:SurfaceObserver ;
    surf:usesVocabulary surf:WaiAriaVocabulary ;
    surf:runtime "playwright" ;
    surf:authorityBoundary "OBSERVE" ;
    surf:emits surf:AccessibilityObservationProjection .

surf:AccessibilityObservationProjection a surf:SurfaceObservation ;
    surf:authorityBoundary "OBSERVE" ;
    surf:conformanceRuleFormat surf:ActRulesFormat ;
    surf:resultVocabulary surf:EarlVocabulary .

surf:specification a rdf:Property ;
    rdfs:range rdfs:Resource .

surf:usesVocabulary a rdf:Property ;
    rdfs:domain surf:SurfaceObserver ;
    rdfs:range surf:AccessibilityVocabulary .

surf:runtime a rdf:Property ;
    rdfs:range xsd:string .

surf:authorityBoundary a rdf:Property ;
    rdfs:range xsd:string .

surf:emits a rdf:Property ;
    rdfs:domain surf:SurfaceObserver ;
    rdfs:range surf:SurfaceObservation .

surf:expectedRoleName a rdf:Property ;
    rdfs:domain surf:AccessibilityProbe ;
    rdfs:range xsd:string ;
    rdfs:comment "Concrete WAI-ARIA role name consumed by Playwright getByRole; the WAI-ARIA specification remains authoritative." .

surf:expectedRoleSpec a rdf:Property ;
    rdfs:domain surf:AccessibilityProbe ;
    rdfs:range rdfs:Resource .

surf:expectedAccessibleName a rdf:Property ;
    rdfs:domain surf:AccessibilityProbe ;
    rdfs:range xsd:string .

surf:denotes a rdf:Property ;
    rdfs:domain surf:AccessibilityProbe ;
    rdfs:comment "Links an accessible surface target to the domain object it denotes." .

surf:affordsCapability a rdf:Property ;
    rdfs:domain surf:AccessibilityProbe ;
    rdfs:comment "Links an accessible surface target to a canonical capability identity; it does not grant execution authority." .

surf:conformanceRuleFormat a rdf:Property .
surf:resultVocabulary a rdf:Property .


# DfCM live-operations consumer projections. These terms describe read models
# only; they do not grant SELECT, CONSTRUCT, or DO authority.
surf:OperationalObligation a rdfs:Class ;
    rdfs:comment "OBSERVE-only projection of an upstream-manufactured capability obligation." .

surf:CommandCenterProjection a rdfs:Class ;
    rdfs:comment "Deterministic consumer composition of observations, obligations, planning episodes, capabilities, and receipt identities." .

surf:capabilityId a rdf:Property ;
    rdfs:domain surf:OperationalObligation ;
    rdfs:range xsd:string .

surf:causeRef a rdf:Property ;
    rdfs:domain surf:OperationalObligation ;
    rdfs:range xsd:string .

surf:receiptRef a rdf:Property ;
    rdfs:range xsd:string .

surf:postconditionRef a rdf:Property ;
    rdfs:range xsd:string .

surf:operationalAuthorityBoundary a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "AshSurface operational projections use the literal OBSERVE." .
