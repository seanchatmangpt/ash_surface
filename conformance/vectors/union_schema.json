{"corpusVersion":"2.0.0","kind":"union_schema","vectors":[
  {"description":"member-keyed union: exactly one single-key strict object","expected":{"ok":{"verdicts":[true,true,false,false,false,false,false],"zod":"z.union([z.object({text: z.string()}).strict(), z.object({count: z.number().int()}).strict()])"}},"id":"us/members-keyed","input":{"members":[{"name":"text","type":"string"},{"name":"count","type":"integer"}],"opts":{},"probes":[{"value":{"text":"a"}},{"value":{"count":3}},{"value":{"text":3}},{"value":{"count":3,"text":"a"}},{"value":{}},{"value":{"other":"a"}},{"value":"a"}],"render":"members"},"level":"MUST","notes":""},
  {"description":"zero members render z.any()","expected":{"ok":{"verdicts":[true,true,true],"zod":"z.any()"}},"id":"us/empty-members-any","input":{"members":[],"opts":{},"probes":[{"value":1},{"value":null},{"value":{"a":1}}],"render":"members"},"level":"MUST","notes":""},
  {"description":"tag/tag_value adds a literal tag field (map_with_tag storage)","expected":{"ok":{"verdicts":[true,false,false],"zod":"z.union([z.object({circle: z.number(), kind: z.literal(\"circle\")}).strict()])"}},"id":"us/tagged-map-with-tag","input":{"members":[{"name":"circle","tag":"kind","tag_value":"circle","type":{"kind":"float"}}],"opts":{},"probes":[{"value":{"circle":1.5,"kind":"circle"}},{"value":{"circle":1.5,"kind":"square"}},{"value":{"circle":1.5}}],"render":"members"},"level":"MUST","notes":""},
  {"description":"storage type_and_value renders {discriminator: literal, value: frag}","expected":{"ok":{"verdicts":[true,true,false,false,false],"zod":"z.union([z.object({type: z.literal(\"a\"), value: z.string()}).strict(), z.object({type: z.literal(\"b\"), value: z.number().int()}).strict()])"}},"id":"us/type-and-value","input":{"members":[{"name":"a","tag_value":"a","type":"string"},{"name":"b","tag_value":"b","type":"integer"}],"opts":{"storage":"type_and_value"},"probes":[{"value":{"type":"a","value":"x"}},{"value":{"type":"b","value":2}},{"value":{"type":"b","value":"x"}},{"value":{"type":"c","value":1}},{"value":{"value":"x"}}],"render":"members"},"level":"MUST","notes":""},
  {"description":"a configurable discriminator key","expected":{"ok":{"verdicts":[true,false],"zod":"z.union([z.object({kind: z.literal(\"a\"), value: z.string()}).strict()])"}},"id":"us/custom-discriminator","input":{"members":[{"name":"a","tag_value":"a","type":"string"}],"opts":{"discriminator":"kind","storage":"type_and_value"},"probes":[{"value":{"kind":"a","value":"x"}},{"value":{"type":"a","value":"x"}}],"render":"members"},"level":"MUST","notes":""},
  {"description":"a member tag names the field, overriding the discriminator option","expected":{"ok":{"verdicts":[true,false],"zod":"z.union([z.object({which: z.literal(\"a\"), value: z.string()}).strict()])"}},"id":"us/tag-overrides-discriminator","input":{"members":[{"name":"a","tag":"which","tag_value":"a","type":"string"}],"opts":{"discriminator":"kind","storage":"type_and_value"},"probes":[{"value":{"value":"x","which":"a"}},{"value":{"kind":"a","value":"x"}}],"render":"members"},"level":"MUST","notes":""},
  {"description":"a member definition keeps its constraint chain","expected":{"ok":{"verdicts":[true,false],"zod":"z.union([z.object({name: z.string().min(2)}).strict()])"}},"id":"us/constrained-member","input":{"members":[{"name":"name","type":{"constraints":{"min_length":2},"type":{"kind":"string"}}}],"opts":{},"probes":[{"value":{"name":"ab"}},{"value":{"name":"a"}}],"render":"members"},"level":"MUST","notes":""},
  {"description":"an array member renders z.array of its items","expected":{"ok":{"verdicts":[true,false,true],"zod":"z.union([z.object({ids: z.array(z.guid())}).strict()])"}},"id":"us/array-member","input":{"members":[{"name":"ids","type":{"type":{"items":{"kind":"uuid"},"kind":"array"}}}],"opts":{},"probes":[{"value":{"ids":["123e4567-e89b-42d3-a456-426614174000"]}},{"value":{"ids":["x"]}},{"value":{"ids":[]}}],"render":"members"},"level":"MUST","notes":""},
  {"description":"a nested union renders recursively","expected":{"ok":{"verdicts":[true,false],"zod":"z.union([z.object({inner: z.union([z.object({x: z.string()}).strict()])}).strict()])"}},"id":"us/nested-union","input":{"members":[{"name":"inner","type":{"type":{"kind":"union","members":[{"name":"x","type":"string"}]}}}],"opts":{},"probes":[{"value":{"inner":{"x":"a"}}},{"value":{"inner":{"y":"a"}}}],"render":"members"},"level":"MUST","notes":""},
  {"description":"non-identifier member names are quoted keys","expected":{"ok":{"verdicts":[true,false],"zod":"z.union([z.object({\"my-key\": z.string()}).strict()])"}},"id":"us/quoted-names","input":{"members":[{"name":"my-key","type":"string"}],"opts":{},"probes":[{"value":{"my-key":"a"}},{"value":{"mykey":"a"}}],"render":"members"},"level":"MUST","notes":""},
  {"description":"nesting beyond max_depth is a typed error","expected":{"error":{"detail":1,"kind":"union_depth_exceeded"}},"id":"us/depth-exceeded","input":{"members":[{"name":"inner","type":{"type":{"kind":"union","members":[{"name":"x","type":"string"}]}}}],"opts":{"max_depth":1},"probes":[],"render":"members"},"level":"MUST","notes":""},
  {"description":"members that are not a list are a typed error","expected":{"error":{"detail":{"name":"x"},"kind":"union_members_not_a_list"}},"id":"us/not-a-list","input":{"members":{"name":"x"},"opts":{},"probes":[],"render":"members"},"level":"MUST","notes":""}
]}
